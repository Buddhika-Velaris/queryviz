{
  "name": "queryviz",
  "version": "0.1.0",
  "description": "Run PostgreSQL EXPLAIN locally and analyze the plan with QueryViz",
  "type": "module",
  "bin": {
    "queryviz": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "ora": "^8.1.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
